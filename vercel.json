{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Scout is served by the published Lovable app'",
  "buildCommand": "mkdir -p .vercel-static",
  "outputDirectory": ".vercel-static",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://scout-ear-sound-finder.lovable.app/:path*"
    }
  ]
}
